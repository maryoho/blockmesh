{
  "node_id": "node-a",
  "boot_id": "replace-with-unique-boot-id",
  "service": {
    "device_path": "/dev/blockmesh",
    "lock_path": "/run/lock/blockmesh/bm-metad.lock",
    "request_timeout": "30s",
    "shutdown_timeout": "60s"
  },
  "sanlock": {
    "binary": "/usr/sbin/sanlock",
    "helper_binary": "/usr/local/sbin/bm-lock-helper",
    "ready_dir": "/run/blockmesh/sanlock",
    "lockspace": "blockmesh-lockspace",
    "lock_device": "/dev/mapper/sanlock-lockspace",
    "resource_index_offset": 1048576,
    "resource_alignment_bytes": 1048576
  },
  "san": {
    "sg_persist_binary": "/usr/bin/sg_persist",
    "reservation_type": 6,
    "paths": [
      {
        "device": "/dev/sdX",
        "local_key": 123456789
      }
    ],
    "owner_keys": {
      "node-old/boot-old": [
        987654321
      ]
    },
    "owner_drain_helper": "/usr/local/libexec/blockmesh-owner-drain"
  },
  "runtime": {
    "reader_heartbeat_interval": "250ms"
  },
  "discovery_devices": [
    "/dev/mapper/mpatha"
  ]
}
